{
  "name": "ai-browser-agent",
  "version": "1.0.0",
  "description": "AI Browser Automation Agent",
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --outfile=dist/main/index.js --format=cjs --external:electron --external:playwright --external:playwright-core --external:openai --sourcemap",
    "build:preload": "esbuild src/preload.ts --bundle --platform=node --outfile=dist/preload.js --format=cjs --external:electron --sourcemap",
    "build:renderer": "esbuild src/renderer/renderer.ts --bundle --platform=browser --outfile=dist/renderer/renderer.js --format=iife --sourcemap",
    "build:assets": "cp src/renderer/index.html dist/renderer/index.html && cp src/renderer/styles.css dist/renderer/styles.css",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer && npm run build:assets",
    "start": "npm run build && electron dist/main/index.js",
    "dev": "npm run build && electron dist/main/index.js",
    "postinstall": "npx playwright install chromium"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "dependencies": {
    "openai": "^4.70.0",
    "playwright": "^1.49.0",
    "electron-store": "^10.0.0"
  }
}
